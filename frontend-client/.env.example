# Plantilla de variables del frontend. Copiala como .env (en esta carpeta) y cambiá lo que necesites.
# Vite solo expone al navegador las variables que empiezan con VITE_.
# Ojo: todo lo que va acá queda visible en el código del navegador, nunca pongas claves secretas.

# Dirección de la API del backend (Spring Boot), terminada en /api
VITE_API_URL=http://localhost:8080/api

# Dirección del realtime-service (Socket.io)
VITE_SOCKET_URL=http://localhost:3000
